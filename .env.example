# ═══════════════════════════════════════════════════════════════
# THREAT STORM CYBER DEFENSE PLATFORM — EXAMPLE ENVIRONMENT
# Duplicate this file to .env and insert your real production secrets
# ═══════════════════════════════════════════════════════════════

# Primary Supabase PostgreSQL Cluster & Realtime Endpoints
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_PROJECT_ID=your_supabase_project_ref_id

# Supabase Server-Side Admin / Service Role Secret
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Google OAuth 2.0 Client Authentication
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# VoidX AI / OpenRouter Intelligence API Key
VOIDX_AI_API_KEY=sk-or-v1-your_openrouter_or_voidx_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_or_voidx_api_key_here

# Local Server Runtime Configuration
PORT=3000
NODE_ENV=development
